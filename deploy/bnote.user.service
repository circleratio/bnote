# systemd *user* unit for bnote (runs as your own account, no root needed).
#
# Assumes the repository lives at ~/services/bnote (%h = home directory);
# adjust the paths below otherwise. The app writes note.db next to index.py,
# so the project directory itself must stay writable (ReadWritePaths).
#
# Install:
#   cp deploy/bnote.user.service ~/.config/systemd/user/bnote.service
#   systemctl --user daemon-reload && systemctl --user enable --now bnote
#   sudo loginctl enable-linger $USER   # keep running without a login session

[Unit]
Description=bnote note management service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/services/bnote
ExecStart=%h/services/bnote/.venv/bin/python index.py
Restart=on-failure
RestartSec=5
UMask=0077

# Sandboxing: the process may only write to the project directory.
# Requires unprivileged user namespaces; remove this block if the unit fails
# to start with a namespace-related error.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/services/bnote
PrivateTmp=yes

[Install]
WantedBy=default.target
