# systemd system unit for bnote, running as a dedicated unprivileged user.
#
# Layout assumed by this unit:
#   /opt/bnote            code and .venv, owned by root (read-only for the service)
#   /var/lib/bnote        database directory, owned by bnote (StateDirectory)
#
# Install (see README.md for the full procedure):
#   sudo useradd --system --user-group --no-create-home \
#     --home-dir /nonexistent --shell /usr/sbin/nologin bnote
#   sudo cp deploy/bnote.service /etc/systemd/system/bnote.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now bnote
#
# To run under your own account without root, use bnote.user.service instead.

[Unit]
Description=bnote note management service
After=network.target

[Service]
Type=simple
User=bnote
Group=bnote
WorkingDirectory=/opt/bnote
Environment=BNOTE_DB=/var/lib/bnote/note.db
ExecStart=/opt/bnote/.venv/bin/python index.py
Restart=on-failure
RestartSec=5
UMask=0077

# /var/lib/bnote is created and kept owned by bnote with mode 0700.
StateDirectory=bnote
StateDirectoryMode=0700

# Sandboxing: the only writable path is /var/lib/bnote. If the service fails
# with SIGSYS or "Permission denied", comment out the lines below one by one
# (MemoryDenyWriteExecute and SystemCallFilter are the usual suspects).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
# Only the local reverse proxy may talk to the service.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
